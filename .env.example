# ---------------------------------------------------------------------------
# Variables de entorno del sistema Don Joaquín.
#
# Local:  copiar este archivo a `.env` (o `.env.local`) y completar.
#         El `.env` está en .gitignore: nunca se sube al repo.
# Prod:   están cargadas en Vercel → don-joaquin → Settings → Environment
#         Variables (Production and Preview). Para bajarlas ya completas:
#             npm i -g vercel && vercel link && vercel env pull .env.local
#
# La lista de abajo es TODO lo que el código lee. Si agregás una variable
# nueva, anotala acá y en la tabla del README, si no se pierde.
# ---------------------------------------------------------------------------

# ── Supabase — OBLIGATORIAS ────────────────────────────────────────────────
# Sin estas tres la app no levanta. Panel de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO server-side. Nunca exponer al cliente ni prefijar con
# NEXT_PUBLIC_ (saltea RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron de notificaciones — OBLIGATORIA en producción ─────────────────────
# /api/cron/notificaciones queda FUERA del middleware de sesión (lo llama
# Vercel Cron, que no tiene cookie), así que se protege con este secreto.
CRON_SECRET=

# ── SMTP — opcional en local, obligatorio para que salgan los mails ─────────
# Si falta cualquiera de las cuatro, el sistema no manda mails. No rompe: lo
# avisa en la UI (ver `emailConfigurado()` en src/lib/email.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente de los mails. Si falta, se usa SMTP_USER.
EMAIL_FROM=
# Opcional. Si no se define: true en el puerto 465, false en el resto.
# No está cargada en Vercel, y está bien: los puertos usuales se autodetectan.
SMTP_SECURE=

# ── URL pública del sistema — opcional ─────────────────────────────────────
# Solo hace falta como OVERRIDE manual. `appUrl()` (src/lib/email.ts) resuelve
# en este orden:
#   NEXT_PUBLIC_APP_URL → VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL → localhost
# En producción no hace falta cargarla: Vercel inyecta sola
# VERCEL_PROJECT_PRODUCTION_URL con el dominio bueno. En local, sin nada,
# cae en http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Las inyecta Vercel sola en el deploy. NO cargarlas a mano:
#   VERCEL_URL                     el deploy puntual (…-a1b2c3.vercel.app)
#   VERCEL_PROJECT_PRODUCTION_URL  el dominio de producción
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OJO — NEXT_PUBLIC_SITE_URL está cargada en Vercel (08/05) pero NO la lee
# nadie en el repo: es plata muerta. La variable que el código mira se llama
# NEXT_PUBLIC_APP_URL. Si alguna vez hace falta fijar la URL a mano, renombrala
# en Vercel; si no, se puede borrar. Se deja anotado acá para que el que la vea
# en el panel no crea que está haciendo algo.
# ---------------------------------------------------------------------------
