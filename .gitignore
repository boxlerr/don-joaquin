# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# iCloud sincroniza ~/Documents y le corrompe la caché de build a Turbopack
# (archivos que desaparecen a mitad de escritura). iCloud NO toca lo que termina
# en ".nosync", así que la caché vive ahí y .next es un symlink que apunta
# adentro del repo — si apuntara afuera, se pierde el node_modules de arriba.
# Sin barra final para que el patrón tape también al symlink.
/.next
/.next.nosync
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos la plantilla: el README manda a copiarla, así que tiene que estar
# en el repo. Los secretos siguen fuera porque `.env` y `.env.local` sí caen
# en el patrón de arriba.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Claude Code (skills, agentes, memoria, reglas locales)
/.claude/
CLAUDE.md
CLAUDE.local.md

# Fixtures locales con datos reales (Excels de Bárbara, etc.)
/__fixtures__/

# Playwright screenshots y snapshots de pruebas manuales
/.playwright-mcp/

# Salida temporal de scripts (previews de emails, etc.)
.tmp/

# Caché de las planillas del Drive (PDFs de Bárbara + .txt/.xml derivados)
/.metricas-drive/

# Backups de la base (datos reales del cliente: nunca al repo)
/backups/
